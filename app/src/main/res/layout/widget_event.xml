<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="8dp">
    <TextView android:id="@+id/widget_divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="#3A3A3A" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#A3A3A3" android:fontFamily="sans-serif-medium" android:paddingTop="8dp" android:paddingBottom="7dp" android:letterSpacing="0.04" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_time" android:layout_width="88dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#C7C7C7" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:fontFamily="sans" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#F2F2F2" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/widget_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#A3A3A3" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
